<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Chatter.App</RootNamespace>
    <AssemblyName>chatter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\chatter.ico</ApplicationIcon>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="Resources\chatter.ico" LogicalName="Chatter.App.Resources.chatter.ico" />
    <EmbeddedResource Include="Resources\Transcript.html" LogicalName="Chatter.App.Transcript.html" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chatter.Core\Chatter.Core.csproj" />
    <ProjectReference Include="..\Chatter.Bridge\Chatter.Bridge.csproj" />
  </ItemGroup>
  <Target Name="EmbedWebViewLoader" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup><EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2/1.0.4314.35/runtimes/win-x86/native/WebView2Loader.dll" LogicalName="Chatter.Native.WebView2Loader.dll" /></ItemGroup>
  </Target>
  <Target Name="EmbedProjectLibraries" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>Chatter.Bundle.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
